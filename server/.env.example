# Copy to server/.env for local `npm run dev`. Never commit the filled-in file.
# On Vercel, set these as environment variables. Do not put them in the mobile app.

# Owner's OpenAI key. The old Vibecode key must not be used.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-mini (vision, fast enough for the 20s bar).
OPENAI_MODEL=

# RevenueCat secret (REST) API key. Server-side only. Starts with sk_.
REVENUECAT_SECRET_API_KEY=

# Optional shared secret so the eval harness can call /api/analyze without a subscriber.
# The app never sends this.
DEERAGE_EVAL_TOKEN=

# Soft update prompt. Installed builds older than MIN_APP_VERSION see "Update available".
MIN_APP_VERSION=1.0.8
LATEST_APP_VERSION=1.0.8
