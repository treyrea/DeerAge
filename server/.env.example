# Copy to server/.env for local `npm run dev`. Never commit the filled-in file.
# On Vercel, set these as environment variables. Do not put them in the mobile app.

# Owner's OpenAI key. The old Vibecode key must not be used.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-sol. GPT-5 models use max_completion_tokens and reasoning_effort.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_REASONING_TOKEN_HEADROOM=4096

# RevenueCat secret (REST) API key. Server-side only. Starts with sk_.
REVENUECAT_SECRET_API_KEY=
# Used to auto-grant a free month. Falls back to REVENUECAT_SECRET_API_KEY. Optional project id for the subscriber count.
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
# Auto free-month cap. The larger of the minimum and this percent of active subscribers. Month is America/Chicago.
FREE_MONTH_CAP_MIN=10
FREE_MONTH_CAP_PCT=5

# Optional shared secret so the eval harness can call /api/analyze without a subscriber.
# The app never sends this.
DEERAGE_EVAL_TOKEN=

# Soft update prompt. Installed builds older than MIN_APP_VERSION see "Update available".
# Raise MIN_APP_VERSION to 1.0.9 after that build is on the App Store.
MIN_APP_VERSION=1.0.8
LATEST_APP_VERSION=1.0.9

# Bearer token for /api/admin/*. Long random string. Never commit a real value.
ADMIN_TOKEN=

# HMAC secret for pre-shot records. Long random string. Never commit a real value.
RECORD_SIGNING_SECRET=

# Vercel AI Gateway. The phone never sees this key.
AI_GATEWAY_API_KEY=
# Optional. Defaults to https://ai-gateway.vercel.sh/v1
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Model ids. Override only the ones you want to change.
FAST_MODEL=openai/gpt-5.6-sol
AGE_MODEL=anthropic/claude-fable-5.2
# Eval only. MAIN_MODEL replaces the main read. MAIN_ENSEMBLE runs those models together.
# MAIN_MODEL=google/gemini-4-carbon
# MAIN_ENSEMBLE=google/gemini-4-carbon,anthropic/claude-fable-5.2
# Antler-blind reads run in parallel. 2 or 3. Default 3.
MASKED_RUNS=3
# Second look. Defaults to AGE_MODEL. One free look per scan, about $0.09.
SECOND_LOOK_MODEL=anthropic/claude-fable-5.2
AGE_FALLBACK_MODEL=google/gemini-4-carbon
MASK_BOX_MODEL=openai/gpt-6.1-sol
SCORE_MODEL=google/gemini-4-carbon
SCORE_FALLBACK_MODEL=anthropic/claude-fable-5.2

# Paywall product ids. The app does not create these. Empty win-back means no offer is shown.
PAYWALL_OFFERING_ID=default
SEASON_PASS_PRODUCT_ID=deerage_season
SEASON_ANNUAL_PRODUCT_ID=season_annual
MONTHLY_PRODUCT_ID=deerage_monthly
WIN_BACK_OFFER_ID=

# Optional. Expo push access token. Sends work without it. Set it if Expo asks for one.
EXPO_ACCESS_TOKEN=

# Upstash Redis from the Vercel Marketplace (Vercel KV is this integration now).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Subscriber fair use. Stored per RevenueCat app user id.
FAIR_USE_DAILY=10
FAIR_USE_MONTHLY=40
FAIR_USE_TIMEZONE=America/Chicago

# Durable per-minute limit, shared across instances.
RATE_LIMIT_PER_MINUTE=8
EVAL_RATE_LIMIT_PER_MINUTE=120

# Per-minute caps for the public community routes. Keyed by app user id.
FEED_RATE_LIMIT_PER_MINUTE=40
VOTE_RATE_LIMIT_PER_MINUTE=12
PUSH_TOKEN_RATE_LIMIT_PER_MINUTE=10
EMAIL_RATE_LIMIT_PER_MINUTE=6
ADMIN_RATE_LIMIT_PER_MINUTE=30
HARVEST_RATE_LIMIT_PER_MINUTE=12

# Blocking update for 1.0.9+. Leave at 1.0.0 until a build must be forced.
MIN_SUPPORTED_VERSION=1.0.0

# Global circuit breaker. Estimated from OpenAI token usage.
DAILY_SPEND_CAP_USD=25
# Working rates for gpt-5.6-sol. List price after Nov 30, 2026 is about $5 / $30.
OPENAI_INPUT_USD_PER_MILLION=4
OPENAI_OUTPUT_USD_PER_MILLION=20
# Leave at 1. Do not fit this to the public eval photos.
SCORE_CALIBRATION=1
