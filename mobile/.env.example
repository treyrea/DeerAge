# Public client values only. Never put an OpenAI key or the RevenueCat secret key here.
# For store builds, set the same names as EAS secrets. Do not set them to empty
# strings in eas.json, because that overrides the secrets.

# RevenueCat Apple public SDK key (starts with appl_).
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=

# Proxy origin, no trailing slash. Example: https://deerage-proxy.vercel.app
EXPO_PUBLIC_API_BASE_URL=
